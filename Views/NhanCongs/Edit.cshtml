@model QuanLyCongTrinhXayDung.Models.NhanCong

@{
    ViewData["Title"] = "Sửa nhân công";
}

<h1>Sửa nhân công</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="HoTen" class="control-label"></label>
                <select asp-for="HoTen" class="form-control" asp-items="ViewBag.ThanhVienList">
                    <option value="">-- Chọn thành viên --</option>
                </select>
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GiaiDoanId" class="control-label"></label>
                <select asp-for="GiaiDoanId" class="form-control" asp-items="ViewBag.GiaiDoanId"></select>
                <span asp-validation-for="GiaiDoanId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ChucVuId" class="control-label"></label>
                <select asp-for="ChucVuId" class="form-control" asp-items="ViewBag.ChucVuId"></select>
                <span asp-validation-for="ChucVuId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Luong" class="control-label"></label>
                <input asp-for="Luong" class="form-control" />
                <span asp-validation-for="Luong" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NgayBatDau" class="control-label"></label>
                <input asp-for="NgayBatDau" class="form-control" type="date" />
                <span asp-validation-for="NgayBatDau" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NgayKetThuc" class="control-label"></label>
                <input asp-for="NgayKetThuc" class="form-control" type="date" />
                <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
