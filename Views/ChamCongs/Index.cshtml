@model IEnumerable<QuanLyCongTrinhXayDung.Models.ChamCong>

@{
    ViewData["Title"] = "Chấm Công";
    int chamHomNay = ViewBag.ChamCongHomNay ?? 0;
    int tongHoatDong = ViewBag.TongNhanCongHoatDong ?? 0;
    int chuaCham = ViewBag.ChuaChamHomNay ?? 0;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-calendar-check-fill text-success"></i> Chấm Công</h2>
            <p class="text-muted mb-0">Ngày hôm nay: <strong>@DateTime.Today.ToString("dd/MM/yyyy")</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i>Thêm thủ công
            </a>
            <form asp-action="ChamCongTuDong" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold"
                        onclick="return confirm('Chấm công tự động cho tất cả nhân công đang thi công hôm nay?')">
                    <i class="bi bi-lightning-fill me-2"></i>Chấm công tự động
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thống kê hôm nay -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <i class="bi bi-check-circle-fill display-5"></i>
                    <div>
                        <div class="fs-2 fw-bold lh-1">@chamHomNay</div>
                        <div class="small opacity-75">Đã chấm công hôm nay</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <i class="bi bi-person-x-fill display-5"></i>
                    <div>
                        <div class="fs-2 fw-bold lh-1">@chuaCham</div>
                        <div class="small">Chưa chấm hôm nay</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <i class="bi bi-people-fill display-5"></i>
                    <div>
                        <div class="fs-2 fw-bold lh-1">@tongHoatDong</div>
                        <div class="small opacity-75">Nhân công đang hoạt động</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (chuaCham > 0)
    {
        <div class="alert alert-info d-flex align-items-center gap-3">
            <i class="bi bi-info-circle-fill fs-4"></i>
            <div>
                Còn <strong>@chuaCham nhân công</strong> chưa được chấm công hôm nay.
                Bấm <strong>"Chấm công tự động"</strong> để cập nhật ngay.
            </div>
        </div>
    }

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 pt-3 pb-0">
            <h6 class="fw-bold text-muted">Lịch sử chấm công</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nhân công</th>
                        <th>Công trình / Giai đoạn</th>
                        <th class="text-center">Ngày chấm</th>
                        <th class="text-center">Đến - Về</th>
                        <th class="text-center">Số công</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isToday = item.Ngay.Date == DateTime.Today;
                        <tr class="@(isToday ? "table-success" : "")">
                            <td class="ps-4 fw-bold">
                                <i class="bi bi-person-circle me-2 text-muted"></i>
                                @(item.NhanCong?.HoTen ?? "—")
                            </td>
                            <td class="text-muted small">
                                @(item.NhanCong?.GiaiDoan?.CongTrinh?.TenCongTrinh ?? "—")
                                @if (item.NhanCong?.GiaiDoan != null)
                                {
                                    <span class="ms-1 text-info">/ @item.NhanCong.GiaiDoan.TenGiaiDoan</span>
                                }
                            </td>
                            <td class="text-center">
                                @item.Ngay.ToString("dd/MM/yyyy")
                                @if (isToday)
                                {
                                    <span class="badge bg-success ms-1">Hôm nay</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="small fw-bold">
                                    <span class="text-primary" title="Giờ đến">@(item.GioDen?.ToString(@"hh\:mm") ?? "--:--")</span>
                                    <span class="text-muted mx-1">-</span>
                                    <span class="text-warning" title="Giờ về">@(item.GioVe?.ToString(@"hh\:mm") ?? "--:--")</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-3">@item.SoCong công</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-4 d-block mb-2"></i>
                                Chưa có dữ liệu chấm công. Bấm "Chấm công tự động" để bắt đầu.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 text-muted small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Tự động hóa:</strong> Hệ thống sẽ tự chấm công lúc <strong>17:00 mỗi ngày</strong> cho tất cả nhân công trong giai đoạn đang thi công.
        Bạn có thể bấm "Chấm công tự động" để chạy ngay lập tức bất kỳ lúc nào.
    </div>
</div>
