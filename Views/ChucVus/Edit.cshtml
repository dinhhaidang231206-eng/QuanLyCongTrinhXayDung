@model QuanLyCongTrinhXayDung.Models.ChucVu

@{
    ViewData["Title"] = "Sửa Chức Vụ";
    bool isAdmin = Model.TenChucVu == "Admin" || Model.TenChucVu == "Quản trị viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header @(isAdmin ? "bg-danger" : "bg-primary") text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi @(isAdmin ? "bi-shield-fill" : "bi-briefcase-fill") me-2"></i>
                        Sửa Chức Vụ: @Model.TenChucVu
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (isAdmin)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-shield-exclamation me-2"></i>
                            <strong>Chức vụ hệ thống:</strong> Đây là chức vụ có quyền quản trị. Chỉ có thể sửa phần mô tả.
                        </div>
                    }

                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="TenChucVu" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên chức vụ</label>
                            <div class="input-group">
                                <span class="input-group-text @(isAdmin ? "bg-danger text-white" : "bg-light")">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input type="text" class="form-control bg-light" value="@Model.TenChucVu" disabled />
                            </div>
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>Tên chức vụ không thể thay đổi để đảm bảo tính nhất quán của hệ thống.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả nhiệm vụ</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4"
                                      placeholder="Mô tả chi tiết về nhiệm vụ, trách nhiệm, phạm vi công việc của chức vụ này..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-save me-2"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
