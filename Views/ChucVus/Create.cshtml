@model QuanLyCongTrinhXayDung.Models.ChucVu

@{
    ViewData["Title"] = "Thêm Chức Vụ";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-briefcase-fill me-2"></i>Thêm Chức Vụ Mới</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Lưu ý:</strong> Chức vụ có tên <strong>"Admin"</strong> hoặc <strong>"Quản trị viên"</strong> sẽ được cấp toàn quyền quản trị hệ thống.
                    </div>

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="TenChucVu" class="form-label fw-bold">Tên chức vụ <span class="text-danger">*</span></label>
                            <input asp-for="TenChucVu" class="form-control" placeholder="VD: Kỹ sư, Thợ hồ, Giám sát..." />
                            <span asp-validation-for="TenChucVu" class="text-danger"></span>
                            <div class="form-text">Tên chức vụ sẽ không thể thay đổi sau khi tạo.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả nhiệm vụ, trách nhiệm của chức vụ này..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-plus-circle me-2"></i>Tạo chức vụ
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
