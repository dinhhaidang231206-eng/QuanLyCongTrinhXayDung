@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-5">
                <i class="bi bi-shield-lock-fill display-1 text-danger mb-4"></i>
                <h1 class="fw-bold text-danger">Từ chối truy cập!</h1>
                <p class="lead text-muted mb-4">Xin lỗi, bạn không có quyền hạn để truy cập vào khu vực quản trị này.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 rounded-pill">Quay lại Trang chủ</a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">Đăng xuất</a>
                </div>
            </div>
        </div>
    </div>
</div>
