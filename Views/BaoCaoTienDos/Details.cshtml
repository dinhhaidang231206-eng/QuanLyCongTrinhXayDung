@model QuanLyCongTrinhXayDung.Models.BaoCaoTienDo

@{
    ViewData["Title"] = "Chi tiết báo cáo";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách báo cáo</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i> Chi tiết Báo cáo tiến độ</h4>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.TieuDe)</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.TieuDe)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.UuTien)</dt>
                        <dd class="col-sm-8">
                            @{
                                var badgeClass = Model.UuTien switch
                                {
                                    QuanLyCongTrinhXayDung.Models.DoUuTien.Thap => "bg-success",
                                    QuanLyCongTrinhXayDung.Models.DoUuTien.TrungBinh => "bg-info",
                                    QuanLyCongTrinhXayDung.Models.DoUuTien.Cao => "bg-warning",
                                    QuanLyCongTrinhXayDung.Models.DoUuTien.KhanCap => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@Html.DisplayFor(model => model.UuTien)</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.GiaiDoan)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.GiaiDoan.TenGiaiDoan)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NgayBaoCao)</dt>
                        <dd class="col-sm-8">@Model.NgayBaoCao.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NguoiBaoCao)</dt>
                        <dd class="col-sm-8">@(Model.NguoiBaoCao?.HoTen ?? "N/A")</dd>
                    </dl>
                </div>
                <div class="col-md-12 mt-4">
                    <dt class="text-muted mb-2">@Html.DisplayNameFor(model => model.NoiDung)</dt>
                    <dd class="bg-light p-3 rounded border">@Html.DisplayFor(model => model.NoiDung)</dd>
                </div>
            </div>

            <div class="mt-4">
                <h5 class="fw-bold mb-3 text-success"><i class="bi bi-chat-dots me-2"></i> Phản hồi từ Quản trị viên</h5>
                @if (!string.IsNullOrEmpty(Model.TraLoi))
                {
                    <div class="p-3 rounded border bg-light border-success">
                        @Html.DisplayFor(model => model.TraLoi)
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary py-2 mb-0">
                        Chưa có phản hồi nào cho báo cáo này.
                    </div>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Quản trị viên"))
                {
                    <div class="mt-3">
                        <form asp-action="Reply" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="form-group mb-2">
                                <textarea name="traLoi" class="form-control" rows="2" placeholder="Nhập nội dung phản hồi..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-send me-1"></i> Gửi phản hồi</button>
                        </form>
                    </div>
                }
            </div>

            <div class="mt-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-images text-info me-2"></i> Hình ảnh thực tế</h5>
                <div class="row g-3">
                    @if (Model.HinhAnhs != null && Model.HinhAnhs.Any())
                    {
                        foreach (var img in Model.HinhAnhs)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="@img.DuongDan" target="_blank">
                                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                                        <img src="@img.DuongDan" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Ảnh báo cáo" />
                                        <div class="card-footer bg-white text-center py-2">
                                            <span class="small text-primary"><i class="bi bi-zoom-in"></i> Phóng to</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-light border text-center py-5">
                                <i class="bi bi-image text-muted display-4 d-block mb-3"></i>
                                <span class="text-muted">Không có hình ảnh đính kèm nào cho báo cáo này.</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer bg-light py-3 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại danh sách</a>
        </div>
    </div>
</div>
