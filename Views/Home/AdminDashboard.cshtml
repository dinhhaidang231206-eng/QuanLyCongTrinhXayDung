@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-0">Quản trị Hệ thống</h1>
            <p class="text-muted">Chào mừng trở lại, <strong>@User.Identity.Name</strong></p>
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2">Quản trị viên</span>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-building display-4 mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.CountCongTrinh</h2>
                    <p class="mb-0 text-white-50">Dự án đang triển khai</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-people display-4 mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.CountNhanCong</h2>
                    <p class="mb-0 text-white-50">Nhân sự hoạt động</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 bg-warning text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tools display-4 mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.CountMayMoc</h2>
                    <p class="mb-0 text-muted">Máy móc thiết bị</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-exclamation-triangle display-4 mb-3"></i>
                    <h2 class="fw-bold">@ViewBag.CountTreTienDo</h2>
                    <p class="mb-0 text-white-50">Cảnh báo trễ tiến độ</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-lightning-charge text-warning"></i> Quản lý Nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a asp-controller="CongTrinhs" asp-action="Create" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 mb-2 rounded bg-light p-3">
                            <div>
                                <h6 class="mb-0 fw-bold">Thêm mới Dự án</h6>
                                <small class="text-muted">Khởi tạo hồ sơ công trình mới</small>
                            </div>
                            <i class="bi bi-plus-circle text-primary fs-4"></i>
                        </a>
                        <a asp-controller="NhanCongs" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 mb-2 rounded bg-light p-3">
                            <div>
                                <h6 class="mb-0 fw-bold">Phân bổ Nhân sự</h6>
                                <small class="text-muted">Quản lý đội ngũ thi công</small>
                            </div>
                            <i class="bi bi-people text-success fs-4"></i>
                        </a>
                        <a asp-controller="ThanhViens" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 rounded bg-light p-3">
                            <div>
                                <h6 class="mb-0 fw-bold">Phân quyền Hệ thống</h6>
                                <small class="text-muted">Cấp quyền Admin/Thành viên</small>
                            </div>
                            <i class="bi bi-shield-lock text-danger fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 bg-dark text-white illustration-card">
                <div class="card-body text-center d-flex flex-column justify-content-center align-items-center p-5">
                    <i class="bi bi-speedometer2 display-1 mb-4 text-info"></i>
                    <h4 class="fw-bold mb-3">Hiệu suất Hệ thống</h4>
                    <p class="text-white-50 mb-4">Tất cả các mô-đun đang hoạt động bình thường. Bạn có toàn quyền truy cập trang quản trị.</p>
                    <a asp-controller="CongTrinhs" asp-action="Index" class="btn btn-info rounded-pill px-4 fw-bold">Xem tất cả Công trình</a>
                </div>
            </div>
        </div>
    </div>
</div>
