@model IEnumerable<QuanLyCongTrinhXayDung.Models.ThanhVien>

@{
    ViewData["Title"] = "Quản lý Thành viên";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary"></i> Quản lý Thành viên</h2>
            <p class="text-muted">Cấp và thu hồi quyền quản trị viên cho thành viên</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-person-plus me-2"></i>Thêm thành viên
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Họ tên</th>
                        <th>Email</th>
                        <th>Tên đăng nhập</th>
                        <th class="text-center">Vai trò hiện tại</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isAdmin = item.ChucVu?.TenChucVu == "Admin" || item.ChucVu?.TenChucVu == "Quản trị viên";
                        <tr>
                            <td class="ps-4 fw-bold">
                                <i class="bi bi-person-circle me-2 text-muted"></i>@item.HoTen
                            </td>
                            <td>@item.Email</td>
                            <td><code>@item.TenDangNhap</code></td>
                            <td class="text-center">
                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">
                                        <i class="bi bi-shield-fill me-1"></i>Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                        <i class="bi bi-person me-1"></i>@(item.ChucVu?.TenChucVu ?? "Thành viên")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai)
                                {
                                    <span class="badge bg-success rounded-pill">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Vô hiệu</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    @if (!isAdmin)
                                    {
                                        <form asp-action="CapAdmin" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="return confirm('Cấp quyền Admin cho @item.HoTen?')">
                                                <i class="bi bi-shield-plus me-1"></i>Cấp Admin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ThuHoiAdmin" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3"
                                                    onclick="return confirm('Thu hồi quyền Admin của @item.HoTen?')">
                                                <i class="bi bi-shield-minus me-1"></i>Thu hồi
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
